        {
          "name": "TC07 - Xác minh vehicleId mới tạo xuất hiện trong danh sách",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC07 - Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC07 - List contains vehicleId created in TC01\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var list = Array.isArray(jsonData) ? jsonData : (jsonData.items || jsonData.content || []);",
                  "    var targetId = pm.environment.get(\"vehicleId\") || pm.collectionVariables.get(\"vehicleId\");",
                  "    ",
                  "    var isFound = list.some(function(item) {",
                  "        return (item.vehicleId === targetId || item.id === targetId);",
                  "    });",
                  "    pm.expect(isFound, \"Created vehicleId was found in the returned list\").to.be.true;",
                  "});"
                ],
