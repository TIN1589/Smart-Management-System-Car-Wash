    {
      "name": "03. Nhóm 3 - Cập nhật & Quản lý xe chính (Update & Set Primary)",
      "description": "Các kịch bản kiểm thử API PUT/PATCH /api/vehicles/{vehicleId}",
      "item": [
        {
          "name": "TC08 - Cập nhật thông tin xe hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC08 - Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"TC08 - Vehicle properties updated correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.vehicleType).to.eql(\"SUV\");",
                  "    pm.expect(jsonData.brand).to.eql(\"Toyota Fortuner\");",
                  "    pm.expect(jsonData.color).to.eql(\"Đen Nhám\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
