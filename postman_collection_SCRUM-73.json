  "item": [
    {
      "name": "00. Setup (Tự động cấp Token & Chuẩn bị dữ liệu)",
      "description": "Đăng ký tài khoản mới động cho mỗi lần test để đảm bảo 100% có Token hợp lệ và không bị phụ thuộc vào dữ liệu cũ.",
      "item": [
        {
          "name": "Setup 01 - Khởi tạo & Đăng ký Tài khoản Chính (Lấy Token mới)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Sinh số điện thoại test ngẫu nhiên 10 chữ số",
                  "var randomPhone = \"09\" + Math.floor(10000000 + Math.random() * 90000000);",
                  "pm.environment.set(\"mainPhone\", randomPhone);",
                  "pm.collectionVariables.set(\"mainPhone\", randomPhone);",
                  "pm.variables.set(\"mainPhone\", randomPhone);",
                  "console.log(\"[SETUP 01] Khởi tạo tài khoản chính với số điện thoại:\", randomPhone);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Setup 01 - Đăng ký tài khoản chính thành công (201 Created)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Setup 01 - Tự động lưu Token vào {{token}}\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var accessToken = jsonData.accessToken || jsonData.token;",
                  "    pm.expect(accessToken, \"Access token không được rỗng\").to.not.be.undefined;",
                  "    ",
                  "    pm.environment.set(\"token\", accessToken);",
                  "    pm.collectionVariables.set(\"token\", accessToken);",
                  "    console.log(\"[SETUP 01] Token cấp mới:\", accessToken.substring(0, 25) + \"...\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Tester SCRUM-73\",\n  \"phone\": \"{{mainPhone}}\",\n  \"email\": \"tester_{{$randomInt}}@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Setup 02 - Khởi tạo & Đăng ký Tài khoản thứ 2",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomPhone2 = \"08\" + Math.floor(10000000 + Math.random() * 90000000);",
                  "pm.environment.set(\"user2Phone\", randomPhone2);",
                  "pm.collectionVariables.set(\"user2Phone\", randomPhone2);",
                  "pm.variables.set(\"user2Phone\", randomPhone2);",
                  "console.log(\"[SETUP 02] Khởi tạo tài khoản 2 với số điện thoại:\", randomPhone2);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Setup 02 - Đăng ký tài khoản 2 thành công (201 Created)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Setup 02 - Lưu tokenUser2\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var accessToken = jsonData.accessToken || jsonData.token;",
                  "    pm.environment.set(\"tokenUser2\", accessToken);",
                  "    pm.collectionVariables.set(\"tokenUser2\", accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Second User SCRUM-73\",\n  \"phone\": \"{{user2Phone}}\",\n  \"email\": \"user2_{{$randomInt}}@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Setup 03 - Tạo xe cho Tài khoản 2 (Lấy otherVehicleId test bảo mật)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSuffix = Math.floor(10000 + Math.random() * 90000);",
                  "var plate = \"51G-\" + randomSuffix;",
                  "pm.variables.set(\"randomPlateUser2\", plate);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Setup 03 - Tạo xe cho User 2 thành công\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Setup 03 - Lưu otherVehicleId phục vụ TC09 và TC13\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var id = jsonData.vehicleId || jsonData.id;",
                  "    pm.expect(id).to.not.be.undefined;",
                  "    pm.environment.set(\"otherVehicleId\", id);",
                  "    pm.collectionVariables.set(\"otherVehicleId\", id);",
                  "    console.log(\"[SETUP 03] Đã lưu otherVehicleId:\", id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenUser2}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"{{randomPlateUser2}}\",\n  \"vehicleType\": \"SUV\",\n  \"brand\": \"Mazda\",\n  \"color\": \"Đỏ\",\n  \"primary\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            }
          },
          "response": []
