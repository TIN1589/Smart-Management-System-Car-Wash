    {
      "name": "01. Nhóm 1 - Tạo xe mới (Create Vehicle)",
      "description": "Các kịch bản kiểm thử API POST /api/vehicles",
      "item": [
        {
          "name": "TC01 - Tạo xe với dữ liệu hợp lệ",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Sinh biển số ngẫu nhiên dạng 29A-XXXXX",
                  "var randomNum = Math.floor(10000 + Math.random() * 90000);",
                  "var plate = \"29A-\" + randomNum;",
                  "pm.environment.set(\"createdLicensePlate\", plate);",
                  "pm.collectionVariables.set(\"createdLicensePlate\", plate);",
                  "pm.variables.set(\"dynamicPlate\", plate);",
                  "console.log(\"[TC01] Testing with dynamic licensePlate:\", plate);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC01 - Status code is 201 Created or 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"TC01 - Response has vehicleId and auto-saved to Environment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var id = jsonData.vehicleId || jsonData.id;",
                  "    pm.expect(id).to.not.be.undefined;",
                  "    ",
                  "    pm.environment.set(\"vehicleId\", id);",
                  "    pm.collectionVariables.set(\"vehicleId\", id);",
                  "    console.log(\"[TC01] Đã lưu vehicleId:\", id);",
                  "});",
                  "",
                  "pm.test(\"TC01 - Vehicle data matches request\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedPlate = pm.environment.get(\"createdLicensePlate\") || pm.collectionVariables.get(\"createdLicensePlate\");",
                  "    pm.expect(jsonData.licensePlate).to.eql(expectedPlate);",
                  "    pm.expect(jsonData.vehicleType).to.eql(\"SEDAN\");",
                  "    pm.expect(jsonData.primary).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"{{dynamicPlate}}\",\n  \"vehicleType\": \"SEDAN\",\n  \"brand\": \"Toyota\",\n  \"color\": \"Trắng\",\n  \"primary\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC02 - Tạo xe thiếu trường bắt buộc",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC02 - Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"TC02 - Error response contains validation message\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message || jsonData.code).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"color\": \"Trắng\",\n  \"primary\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC03 - Tạo xe trùng biển số vừa tạo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC03 - Status code is 400 Bad Request\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});",
                  "",
                  "pm.test(\"TC03 - Error message indicates duplicate license plate\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var msg = (jsonData.message || \"\").toLowerCase();",
                  "    pm.expect(msg).to.satisfy(function(m) {",
                  "        return m.includes(\"ton tai\") || m.includes(\"tồn tại\") || m.includes(\"duplicate\") || m.includes(\"already exists\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"{{createdLicensePlate}}\",\n  \"vehicleType\": \"SEDAN\",\n  \"brand\": \"Honda\",\n  \"color\": \"Đen\",\n  \"primary\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC04 - Tạo xe với dữ liệu không hợp lệ (vượt max size)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC04 - Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"TC04 - Has validation errors in response\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code || jsonData.message).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"licensePlate\": \"BIEN-SO-XE-QUA-DAI-HON-20-KY-TU-123456789\",\n  \"vehicleType\": \"\",\n  \"brand\": \"Xe rat dai vuot qua gioi han ky tu cho phep\",\n  \"color\": \"Đỏ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vehicles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vehicles"
              ]
            }
          },
          "response": []
        }
      ]
    },
